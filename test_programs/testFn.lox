fun sussify(msg) {
    print msg + " is acting mad sus. I think they are the imposter.";
}

fun factorial(n) {
    if (n == 0) return 1;
    return n * factorial(n - 1);
}

fun fib(n) {
  if (n <= 1) return n;
  return fib(n - 2) + fib(n - 1);
}

for (var i = 0; i < 20; i = i + 1) {
  print fib(i);
}

sussify("Red crewmate");

print(factorial(5));
